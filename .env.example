# Patchwork — environment variables (copy to .env and fill in; never commit .env)

# The app's "brain". Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: GitHub token for higher API limits / private repos (public demo repos work without it)
GITHUB_TOKEN=
